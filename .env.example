# Netlify Functions (backend) environment variables.
# Copy to .env for local `netlify dev` use, and set the same keys in
# Netlify's Site settings > Environment variables for production.
# NEVER commit a real .env file.

# Supabase — service role key bypasses RLS; used only inside functions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — used only by netlify/functions/ai-quote-assistant.js.
# Never exposed to the frontend. Deliberately NOT named OPENROUTER_API_KEY
# — Netlify's AI Gateway auto-injects its own gateway JWT into env vars
# matching known AI provider name patterns (for accounts with AI usage
# enabled), silently overriding a real key set under that name. See the
# comment in ai-quote-assistant.js for the full explanation.
QUOTEFORGE_AI_KEY=
OPENROUTER_MODEL=
