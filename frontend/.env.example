# Copy this file to .env and fill in your own Supabase project values.
# These are safe to expose to the client — Supabase access control is
# enforced server-side via Row Level Security (see supabase/migrations).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed if you run `netlify dev` (frontend + functions together) for
# local testing. `netlify dev` reads .env from netlify.toml's `base`
# directory (this one), not the repo root, so the service-role key needs to
# be duplicated here too — safe because it's not VITE_-prefixed, so Vite
# never inlines it into the browser bundle. See the root .env.example for
# the canonical copy used by `npm run dev:netlify`. Production env vars are
# set in the Netlify dashboard, not from either .env file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
